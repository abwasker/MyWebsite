# Ignore OS/system files
.DS_Store
Thumbs.db

# Ignore Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
envAW/

# Ignore secrets / environment (the template .env.example IS committed)
.env

# Ignore the local dev database.
# Untracked 2026-07-31: this repo is PUBLIC, and a SQLite file contains the auth_user
# table - i.e. password hashes - which must not be published. A fresh dev DB is built
# from scratch with `manage.py migrate` (migration 0003 seeds the initial posts) plus
# `manage.py createsuperuser`. Production content comes down via Scope 10.12.
Website/db.sqlite3
Website/db.sqlite3-journal
Website/db.sqlite3-wal
Website/db.sqlite3-shm

# Ignore collectstatic output (regenerated on the server)
Website/staticfiles/

# Ignore runtime logs
*.log
Website/logs/
Website/media/

# Ignore IDE files
.vscode/
.idea/
