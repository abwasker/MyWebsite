# A Notion To Ponder — environment configuration TEMPLATE.
# Copy this file to `.env` (which is gitignored) and fill in real values.
#   Local dev:  cp .env.example .env   (then usually only DJANGO_DEBUG matters)
#   Production: these become the systemd EnvironmentFile (/etc/anotiontoponder.env)
# Never commit the real `.env`.

# --- Core ---
# Leave DJANGO_DEBUG=True for local development; MUST be False in production.
DJANGO_DEBUG=True

# Generate a strong unique key for production (keep it secret). Example generator:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Local dev can omit this (settings.py falls back to an insecure dev key).
SECRET_KEY=

# Comma-separated hostnames the site may serve. Required when DEBUG=False.
# Local dev can leave this blank (falls back to 127.0.0.1,localhost).
DJANGO_ALLOWED_HOSTS=anotiontoponder.com,www.anotiontoponder.com

# Comma-separated HTTPS origins trusted for CSRF (admin/comment POSTs). Production only.
CSRF_TRUSTED_ORIGINS=https://anotiontoponder.com,https://www.anotiontoponder.com

# --- Database ---
# Leave DB_ENGINE unset/blank for local SQLite. Set to "mysql" in production.
DB_ENGINE=
DB_NAME=notion
DB_USER=notion
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Resume page ---
RESUME_ACCESS_PASSWORD=viewresumeonwebsite
RESUME_REQUEST_EMAIL=hello@example.com

# --- Spotify listening tracker ---
# From the Spotify developer dashboard app (https://developer.spotify.com/dashboard).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Obtained by running LOCALLY:  python manage.py spotify_authorize
# The command writes it here for you. Copy the value to /etc/anotiontoponder.env
# on the server - the server never runs the browser flow itself.
# NOTE: expires ~6 months after authorization and fails SILENTLY (no error, just
# no new rows). The Django admin shows a countdown.
SPOTIFY_REFRESH_TOKEN=
# Must match the dashboard registration exactly. Spotify PROHIBITS "localhost" -
# loopback must be an explicit IP literal.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
